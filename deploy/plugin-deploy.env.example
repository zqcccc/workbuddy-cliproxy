# Copy to /opt/plugin-deploy/plugin-deploy.env on cn2, then fill in the secret.
# chmod 600 /opt/plugin-deploy/plugin-deploy.env  (it holds a shared secret)

# Shared secret, must equal the GitHub webhook's "Secret" field.
# Generate: python3 -c 'import secrets;print(secrets.token_hex(32))'
WEBHOOK_SECRET=

# Where the listener binds. Caddy reverse-proxies to this, so localhost only.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=9000

# Which artifact to install. CI names assets workbuddy-<goos>-<goarch>.so.
PLATFORM=linux-amd64

# CPA's plugin directory and the container to restart after install.
PLUGIN_DIR=/root/code/cliproxyapiplus-docker/plugins
CONTAINER_NAME=cli-proxy-api-plus

# Only install assets whose name starts with one of these (comma separated).
ASSET_PREFIXES=workbuddy

# Number of .bak-<timestamp> copies to keep per plugin.
KEEP_BACKUPS=5

# Set to 1 to log what would happen without touching the plugins.
DRY_RUN=0
# Set to 1 to install the file but not restart the container.
NO_RESTART=0

# Optional. Only needed if you use the workflow_run/artifact path instead of
# releases: a fine-grained PAT with public repo read to download artifacts.
GITHUB_TOKEN=
